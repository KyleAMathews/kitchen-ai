{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tanstack/db": ["./vendor/tanstack-db/packages/db/src/index.ts"],
      "@tanstack/db-ivm": [
        "./vendor/tanstack-db/packages/db-ivm/src/index.ts"
      ],
      "@tanstack/react-db": [
        "./vendor/tanstack-db/packages/react-db/src/index.ts"
      ],
      "@tanstack/query-db-collection": [
        "./vendor/tanstack-db/packages/query-db-collection/src/index.ts"
      ],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"],
      "@tanstack/db-endpoints": ["./vendor/endpoints/src/runtime.ts"]
    }
  }
}
