# Database and Neon Realtime: `neon env pull --service postgres --service realtime`
# writes these to .env.local. NEON_REALTIME_SECRET is server-only.
DATABASE_URL="postgresql://user:password@host/kitchen_ai?sslmode=require"
NEON_REALTIME_URL="wss://..."
NEON_REALTIME_SECRET="..."
# Browser copy of NEON_REALTIME_URL; set it yourself to the same value.
VITE_NEON_REALTIME_URL="wss://..."

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="https://kitchen-ai.localhost"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# AWS S3 (if using file uploads)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="your-bucket-name"